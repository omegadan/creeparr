# Creeparr environment variables
#
# Copy to `.env` next to docker-compose.yml; Compose reads it automatically and
# substitutes ${VAR} references. Only paths, port and log level are configured
# here. Everything else (session cookie, scan interval, concurrency, naming
# templates, per-creator options) is stored in the database and edited in the
# web UI under Settings.

# ---- Container user / time zone (linuxserver-style) --------------------------

# User and group id that own the archive files and the config directory.
# Defaults are Unraid's (nobody:users). On other hosts match the owner of your
# media folder (run `id` to see yours).
PUID=99
PGID=100

# Time zone for log timestamps and scheduled scans (IANA name).
TZ=America/Los_Angeles

# ---- Host paths mapped into the container (used by docker-compose.yml) --------

# Where the database, logs and cookie file live. Small; back this up.
# Required by docker-compose.yml. Unraid: /mnt/user/appdata/creeparr
CONFIG_DIR=./config

# Default archive root. Every provider that has no directory of its own below
# archives here. Downloads are written under <creator>/<date - title [id]>/.
# Required by docker-compose.yml. Unraid: e.g. /mnt/user/media/creeparr
DOWNLOAD_DIR=./downloads

# Optional per-provider archive roots. Uncomment one to send that provider's
# media to its own folder (a different disk, a more private share, ...).
# Anything left unset falls back to DOWNLOAD_DIR.
#PATREON_DOWNLOAD_DIR=./downloads-patreon
#ONLYFANS_DOWNLOAD_DIR=./downloads-onlyfans
#YOUTUBE_DOWNLOAD_DIR=./downloads-youtube
#INSTAGRAM_DOWNLOAD_DIR=./downloads-instagram
#REDDIT_DOWNLOAD_DIR=./downloads-reddit

# Host port the web UI is published on (container always listens on 7979).
PORT=7979

# ---- Application settings (inside the container) ------------------------------

# Log verbosity: DEBUG, INFO, WARNING or ERROR. DEBUG is chatty; use it when
# reporting a problem, then switch back.
CREEPARR_LOG_LEVEL=INFO

# Extra host names the web UI may be opened by while no password is set, comma
# separated; `.example.com` also matches its subdomains. IP addresses, bare names
# (e.g. `tower`), localhost and .local/.lan/.home.arpa/.internal/.ts.net names are
# always accepted. Needed only for e.g. a reverse-proxy domain; setting a password
# in Settings -> Security lifts the check instead. `*` turns it off (not advised).
#CREEPARR_ALLOWED_HOSTS=

# The variables below already default to the right values inside the Docker
# image. Uncomment only when running Creeparr outside Docker (e.g. `make backend`).

# Directory for the database, logs and cookie file.
#CREEPARR_CONFIG_DIR=/config

# Default directory where archived media is written.
#CREEPARR_DOWNLOAD_DIR=/downloads

# Per-provider directories. Any that is unset (or empty) uses CREEPARR_DOWNLOAD_DIR.
# Inside Docker these are derived from the host paths above; do not set them here.
#CREEPARR_PATREON_DOWNLOAD_DIR=
#CREEPARR_ONLYFANS_DOWNLOAD_DIR=
#CREEPARR_YOUTUBE_DOWNLOAD_DIR=
#CREEPARR_INSTAGRAM_DOWNLOAD_DIR=
#CREEPARR_REDDIT_DOWNLOAD_DIR=

# Interface and port the HTTP server binds to.
#CREEPARR_HOST=0.0.0.0
#CREEPARR_PORT=7979

# Override the database location (default: <CONFIG_DIR>/creeparr.db).
#CREEPARR_DB_PATH=

# Serve the web UI from a different build directory (development only).
#CREEPARR_STATIC_DIR=

# Path to the ffmpeg binary if it is not on PATH.
#CREEPARR_FFMPEG_PATH=
